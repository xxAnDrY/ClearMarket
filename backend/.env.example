# Copia in .env. Con docker compose DATABASE_URL e REDIS_URL sono gia' impostati.
DATABASE_URL=postgresql://clearmarket:clearmarket@localhost:5432/clearmarket
REDIS_URL=redis://localhost:6379/0

# Senza chiave le fonti Finnhub falliscono con backoff; RSS e calendario funzionano.
FINNHUB_API_KEY=

# Traduzione delle fonti estere. Senza chiave si usa solo MyMemory, con quota ridotta:
# gli articoli esteri oltre la quota restano nascosti, le fonti italiane non ne risentono.
DEEPL_API_KEY=

# Sviluppo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Produzione con Supabase: usa la JWKS e lascia vuoto JWT_SECRET.
# Prendi l'URL esatto dalla dashboard (Authentication > JWT Keys).
# JWT_JWKS_URL=

# Reverse proxy davanti all'API (0 se esposta direttamente).
TRUSTED_PROXY_HOPS=0

# Solo per la versione web dell'app.
# CORS_ORIGINS=http://localhost:8090
